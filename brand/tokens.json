{
  "colors": {
    "dusk": {
      "ground": "#0B0B0D",
      "surface": "#16151A",
      "code": "#0F0E11",
      "text": "#E7DECB",
      "textMuted": "#A39D8F",
      "textQuiet": "#8C8678",
      "brand": "#F8D794",
      "brandDim": "#C9A95F",
      "brandHover": "#E6C36E",
      "onBrand": "#0B0B0D",
      "line": "#211F1A",
      "lineLit": "#332F26",
      "lineStrong": "#6F6658",
      "proof": "#45D483",
      "fail": "#E5675C",
      "syntaxString": "#D9C79F",
      "syntaxType": "#CFC4AC",
      "model": "#B9A6E8",
      "layer": "#8FB8E8"
    },
    "paper": {
      "ground": "#FBF7EE",
      "surface": "#F2EADA",
      "text": "#2A1F10",
      "textMuted": "#625D55",
      "brand": "#6E5220",
      "brandHover": "#4E3A1A",
      "onBrand": "#FBF7EE",
      "line": "#E2D8C3",
      "lineStrong": "#7A7061",
      "proof": "#1B7040",
      "fail": "#A63D35"
    }
  },
  "surfaces": ["ground", "surface", "code"],
  "decorative": ["line", "lineLit"],
  "tints": {
    "brand": [5, 6, 10, 12],
    "fail": [6, 12, 14, 16, 60, 80],
    "proof": [5, 6, 13, 18, 50, 55],
    "layer": [6]
  },
  "syntax": {
    "default": "text",
    "keyword": "brand",
    "name": "brandDim",
    "string": "syntaxString",
    "comment": "textQuiet",
    "punctuation": "textMuted"
  },
  "terminal": {
    "default": "text",
    "black": "textQuiet",
    "red": "fail",
    "green": "proof",
    "yellow": "brand",
    "blue": "textMuted",
    "magenta": "textMuted",
    "cyan": "textMuted",
    "white": "text"
  },
  "fonts": {
    "sans": { "family": "Inter", "fallback": "system-ui, sans-serif" },
    "mono": { "family": "JetBrains Mono", "fallback": "ui-monospace, monospace" }
  },
  "radius": { "control": 8, "frame": 12 },
  "contrast": [
    { "mode": "dusk", "foreground": "text", "on": ["ground", "surface", "code"], "minimum": 4.5 },
    { "mode": "dusk", "foreground": "textMuted", "on": ["ground", "surface", "code"], "minimum": 4.5 },
    { "mode": "dusk", "foreground": "textQuiet", "on": ["ground", "surface", "code"], "minimum": 4.5 },
    { "mode": "dusk", "foreground": "brand", "on": ["ground", "surface", "code"], "minimum": 4.5 },
    { "mode": "dusk", "foreground": "brandDim", "on": ["ground", "surface", "code"], "minimum": 4.5 },
    { "mode": "dusk", "foreground": "brandHover", "on": ["ground", "surface"], "minimum": 4.5 },
    { "mode": "dusk", "foreground": "onBrand", "on": ["brand", "model"], "minimum": 4.5 },
    { "mode": "dusk", "foreground": "lineStrong", "on": ["ground", "surface", "code"], "minimum": 3 },
    { "mode": "dusk", "foreground": "proof", "on": ["ground", "surface", "code"], "minimum": 4.5 },
    { "mode": "dusk", "foreground": "fail", "on": ["ground", "surface", "code"], "minimum": 4.5 },
    { "mode": "dusk", "foreground": "syntaxString", "on": ["code"], "minimum": 4.5 },
    { "mode": "dusk", "foreground": "syntaxType", "on": ["code"], "minimum": 4.5 },
    { "mode": "dusk", "foreground": "model", "on": ["ground", "surface", "code"], "minimum": 4.5 },
    { "mode": "dusk", "foreground": "layer", "on": ["ground", "surface", "code"], "minimum": 4.5 },
    { "mode": "paper", "foreground": "text", "on": ["ground", "surface"], "minimum": 4.5 },
    { "mode": "paper", "foreground": "textMuted", "on": ["ground", "surface"], "minimum": 4.5 },
    { "mode": "paper", "foreground": "brand", "on": ["ground", "surface"], "minimum": 4.5 },
    { "mode": "paper", "foreground": "brandHover", "on": ["ground", "surface"], "minimum": 4.5 },
    { "mode": "paper", "foreground": "onBrand", "on": ["brand"], "minimum": 4.5 },
    { "mode": "paper", "foreground": "lineStrong", "on": ["ground", "surface"], "minimum": 3 },
    { "mode": "paper", "foreground": "proof", "on": ["ground", "surface"], "minimum": 4.5 },
    { "mode": "paper", "foreground": "fail", "on": ["ground", "surface"], "minimum": 4.5 }
  ]
}
