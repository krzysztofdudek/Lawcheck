{
  "hooks": {
    "SessionStart": [
      { "hooks": [ { "type": "command", "command": "node \"${PLUGIN_ROOT}/hooks/lawcheck-hook.mjs\" session-start --host codex", "timeout": 30 } ] }
    ],
    "UserPromptSubmit": [
      { "hooks": [ { "type": "command", "command": "node \"${PLUGIN_ROOT}/hooks/lawcheck-hook.mjs\" prompt --host codex", "timeout": 20 } ] }
    ],
    "PostToolUse": [
      { "matcher": "apply_patch", "hooks": [ { "type": "command", "command": "node \"${PLUGIN_ROOT}/hooks/lawcheck-hook.mjs\" edit --host codex", "timeout": 30 } ] }
    ],
    "Stop": [
      { "hooks": [ { "type": "command", "command": "node \"${PLUGIN_ROOT}/hooks/lawcheck-hook.mjs\" stop --host codex", "timeout": 150 } ] }
    ]
  }
}
