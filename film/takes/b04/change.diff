--- /dev/null
+++ b/src/core/money.ts
@@ -0,0 +1,6 @@
+export function formatMoney(cents: number): string {
+  const sign = cents < 0 ? "-" : "";
+  const whole = Math.floor(Math.abs(cents) / 100);
+  const rest = String(Math.abs(cents) % 100).padStart(2, "0");
+  return `${sign}$${whole}.${rest}`;
+}
