{
  "weakenings": "tests/weakenings.md",
  "tests": [
    "tests/**/*.test.ts"
  ],
  "specs": [
    "design/promises.md",
    "docs/codes.md",
    "docs/json.md"
  ],
  "rulings": "design/decisions.md",
  "docs": [
    "docs/**/*.md",
    "README.md"
  ],
  "numbers": "tests/numbers.ts",
  "sabotage": "tests/sabotage/list.json",
  "runes": "@chrisdudek/runes",
  "platformReasons": {
    "file": "tests/harness/skips.ts",
    "export": "PLATFORM_SKIPS",
    "call": "platformSkip"
  },
  "paths": {
    "guard": [
      "tests/guard/**"
    ],
    "ci": [
      ".github/workflows/**"
    ],
    "harness": [
      "tests/harness/**",
      "tests/run.ts"
    ],
    "expected": [
      "tests/**/*.expected",
      "tests/**/expected/**",
      "tests/**/recordings/**",
      "tests/**/*.schema.json",
      "tests/harness/schemas/**",
      "tests/**/attacks/**",
      "tests/stability/labels.json"
    ],
    "law": [
      ".lawcheck/**"
    ]
  },
  "roles": {
    "owner": "^owner\\b",
    "reviewer": "^reviewer\\s+\\S"
  },
  "approvers": {
    "test-removed": [
      "reviewer"
    ],
    "expected-changed": [
      "reviewer"
    ],
    "docs-example-changed": [
      "reviewer"
    ],
    "sabotage-changed": [
      "reviewer"
    ],
    "sabotage-removed": [
      "reviewer"
    ],
    "harness-changed": [
      "reviewer"
    ],
    "promise-changed": [
      "owner"
    ],
    "guard-changed": [
      "owner"
    ],
    "ci-changed": [
      "owner"
    ],
    "threshold-lowered": [
      "owner"
    ],
    "ratchet-grew": [
      "reviewer"
    ],
    "law-changed": [
      "reviewer"
    ],
    "platform-narrowed": [
      "reviewer"
    ]
  },
  "stronger": "stronger",
  "ratchets": [
    "tests/contract/pending-next.json",
    {
      "file": "tests/harness/skips.ts",
      "lists": [
        "PLATFORM_SKIPS"
      ]
    },
    {
      "file": "tests/acceptance/self-law.test.ts",
      "lists": [
        "ADVISORY",
        "WAIVERS",
        "UNRESOLVED",
        "UNSORTED"
      ]
    }
  ],
  "shrinkOnly": [
    "SLOW_TESTS"
  ],
  "selection": {
    "tests": {
      "file": "tests/harness/sets.ts",
      "export": "PLATFORM_TESTS"
    },
    "promises": {
      "file": "tests/harness/promises.ts",
      "export": "PLATFORM_PROMISES"
    },
    "nightly": [
      "tests/**/*.nightly.test.ts"
    ]
  }
}
