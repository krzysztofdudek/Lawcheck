{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "lawcheck-docs/0, from docs/json.md",
  "oneOf": [
    {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema", "topics"],
      "properties": {
        "schema": { "const": "lawcheck-docs/0" },
        "topics": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "title"],
            "properties": { "id": { "type": "string", "minLength": 1 }, "title": { "type": "string", "minLength": 1 } }
          }
        }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema", "id", "title", "text"],
      "properties": {
        "schema": { "const": "lawcheck-docs/0" },
        "id": { "type": "string", "minLength": 1 },
        "title": { "type": "string", "minLength": 1 },
        "text": { "type": "string", "minLength": 1 }
      }
    }
  ]
}
