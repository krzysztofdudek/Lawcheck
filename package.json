{
  "name": "lawcheck",
  "version": "0.1.0-alpha.1",
  "description": "You write the architecture and the rules. Lawcheck tells your coding agent which line breaks which rule.",
  "license": "MIT",
  "author": "Krzysztof Dudek",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/krzysztofdudek/Lawcheck.git"
  },
  "homepage": "https://github.com/krzysztofdudek/Lawcheck#readme",
  "bugs": "https://github.com/krzysztofdudek/Lawcheck/issues",
  "keywords": [
    "architecture",
    "linter",
    "coding-agents",
    "claude-code",
    "rules"
  ],
  "type": "module",
  "bin": {
    "lawcheck": "dist/bin.js"
  },
  "engines": {
    "node": ">=24"
  },
  "files": [
    "README.md",
    "LICENSE",
    "dist",
    "!dist/grammars/*.node-types.json",
    "docs"
  ],
  "scripts": {
    "build": "tsc -p . && node scripts/grammars.ts --offline",
    "grammars": "node scripts/grammars.ts",
    "prepack": "npm run grammars && npm run build",
    "agent-trial": "node tests/agent/run.ts",
    "real": "npm run build && node tests/real/run.ts",
    "stability": "npm run build && node tests/stability/run.ts",
    "test": "npm run build && node tests/run.ts commit",
    "t": "node tests/run.ts loop",
    "nightly": "npm run build && node tests/run.ts nightly"
  },
  "dependencies": {
    "@chrisdudek/runes": "1.1.0",
    "web-tree-sitter": "0.27.0",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "ajv": "8.17.1",
    "fast-check": "4.10.2",
    "tree-sitter-cli": "0.27.0",
    "tree-sitter-go": "0.25.0",
    "tree-sitter-javascript": "0.25.0",
    "tree-sitter-python": "0.25.0",
    "typescript": "^7.0.2"
  },
  "allowScripts": {
    "tree-sitter-cli@0.27.0": true,
    "tree-sitter-go": false,
    "tree-sitter-javascript": false,
    "tree-sitter-python": false
  }
}
