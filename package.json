{
  "name": "lawcheck",
  "version": "0.1.0-alpha.6",
  "description": "Write your architecture rules once, and stop reading your agent's code to enforce them. Lawcheck holds your coding agent to them while it writes, before it finishes, and in CI, in 12 languages. Free (MIT), runs locally; an AI model only for prose rules.",
  "license": "MIT",
  "author": "Krzysztof Dudek",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/krzysztofdudek/Lawcheck.git"
  },
  "homepage": "https://lawcheck.dev",
  "bugs": "https://github.com/krzysztofdudek/Lawcheck/issues",
  "keywords": [
    "architecture",
    "linter",
    "lint",
    "eslint",
    "coding-agents",
    "claude-code",
    "agents-md",
    "claude-md",
    "hooks",
    "deterministic",
    "ast",
    "tree-sitter",
    "rules"
  ],
  "type": "module",
  "bin": {
    "lawcheck": "dist/bin.cjs"
  },
  "engines": {
    "node": ">=24"
  },
  "files": [
    "README.md",
    "LICENSE",
    "dist",
    "!dist/grammars/*.node-types.json",
    "docs"
  ],
  "scripts": {
    "build": "tsc -p . && node scripts/grammars.ts --offline",
    "grammars": "node scripts/grammars.ts",
    "prepack": "npm run grammars && npm run build",
    "agent-trial": "node tests/agent/run.ts",
    "real": "npm run build && node tests/real/run.ts",
    "stability": "npm run build && node tests/stability/run.ts",
    "test": "npm run build && node tests/run.ts commit",
    "test:shard": "node tests/run.ts commit --shard",
    "t": "node tests/run.ts loop",
    "nightly": "npm run build && node tests/run.ts nightly",
    "gate": "node tests/gate/run.ts"
  },
  "dependencies": {
    "@chrisdudek/runes": "1.2.0",
    "web-tree-sitter": "0.27.2",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "ajv": "8.17.1",
    "fast-check": "4.10.2",
    "typescript": "^7.0.2"
  }
}
